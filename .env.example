# Backend (copy relevant values to apps/backend/.env)
NODE_ENV=development
APP_TIMEZONE=Africa/Casablanca
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TOKEN_TTL_HOURS=12
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# First regional admin seed (backend only)
ADMIN_USERNAME=regional_admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_FULL_NAME=Administrateur régional
REGIONAL_OFFICE_NAME=Bureau régional de monitoring
REGION_LABEL=Région pilote

# Frontend (copy to apps/frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
